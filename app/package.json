{
  "name": "app",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@neon/config": "^1.4.0",
    "@neon/env": "^1.3.0",
    "expo": "~57.0.21",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "babel-preset-expo": "~57.0.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "serve": "^14.2.6",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "prepare": "node scripts/setup-git-hooks.js",
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:web": "expo export -p web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:tokens && npm run test:viewport && npm run test:e2e",
    "test:unit": "jest",
    "test:tokens": "node scripts/check-token-conformance.js",
    "test:viewport": "node scripts/check-viewport-zoom.js",
    "test:e2e": "playwright test"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/e2e/"
    ]
  }
