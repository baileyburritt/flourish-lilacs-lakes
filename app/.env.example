# Copy to .env.local (gitignored) and fill in real values. Never commit
# real values here — this file documents shape only.

# Neon (see app/neon.ts) — pulled via `neon env pull` or the dashboard.
NEON_API_KEY=
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_BRANCH=

# Clerk (E2, §03) — publishable key only; it's safe to expose to the client
# bundle (EXPO_PUBLIC_ vars are inlined at build time), unlike the secret key
# server/.env holds.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

# The server/ Fastify service from E1. Defaults to localhost for dev; gets a
# real per-environment value once Stage F's deploy pipeline exists.
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000

# Sentry (F3, §13) — client-side error tracking, native platforms only (see
# lib/sentry.ts). A DSN is designed to ship in a client bundle, like Clerk's
# publishable key above, so EXPO_PUBLIC_ is safe here. Leaving this unset is
# fine: init is skipped with a console warning instead of failing to start.
# No Sentry account exists yet; the human creates it and hands over the
# real value.
EXPO_PUBLIC_SENTRY_DSN=
