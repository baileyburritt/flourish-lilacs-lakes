# Direct (non-pooled) Neon connection string — required for migrations.
# Copy to .env (gitignored) and fill in from `neon connection-string` or the
# Neon dashboard. Never commit a real value here.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Cloudflare R2 (E6, §12/§16): a private bucket for gem photos and audio
# memos, public access left off. R2_ACCOUNT_ID and R2_BUCKET_NAME identify
# the bucket; R2_ACCESS_KEY_ID and R2_SECRET_ACCESS_KEY are a scoped R2 API
# token (Object Read & Write, that one bucket only). Never commit real values.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Cloudflare R2 (E10, §03/§06): a second, *public* bucket for destination and
# event catalog photography — deliberately separate from the private gem
# bucket above, so a catalog-scoped credential can never reach a private gem
# object. R2_CATALOG_BUCKET_NAME needs public access turned on (either its
# R2.dev "Public Development URL" or a custom domain); R2_CATALOG_PUBLIC_BASE_URL
# is that public base (no trailing slash). R2_CATALOG_ACCESS_KEY_ID/SECRET are
# a scoped R2 API token (Object Read & Write, that one bucket only). Never
# commit real values.
R2_CATALOG_ACCESS_KEY_ID=
R2_CATALOG_SECRET_ACCESS_KEY=
R2_CATALOG_BUCKET_NAME=
R2_CATALOG_PUBLIC_BASE_URL=
